{
  "servers": [
    {"name": "socraticode", "type": "local", "required": true, "clients": ["opencode", "codex", "vscode", "mcp"],
     "command": "node",
     "args": ["-e", "process.env.TMP=process.env.TEMP=require('node:path').resolve('.local/socraticode/tmp'); const p=require('node:child_process').spawn('npx',['-y','socraticode@1.14.0'],{stdio:'inherit',shell:process.platform==='win32'}); p.on('exit',c=>process.exit(c??1));"],
     "env": ["QDRANT_MODE", "QDRANT_URL", "QDRANT_COLLECTION_PREFIX", "EMBEDDING_PROVIDER", "EMBEDDING_MODEL", "OLLAMA_MODE", "OLLAMA_URL", "TMP", "TEMP", "SOCRATICODE_GLOBAL_CONFIG_DIR"],
     "envValues": {"QDRANT_MODE": "external", "QDRANT_URL": "http://127.0.0.1:17333", "QDRANT_COLLECTION_PREFIX": "ausn_qa_", "EMBEDDING_PROVIDER": "ollama", "EMBEDDING_MODEL": "nomic-embed-text", "OLLAMA_MODE": "external", "OLLAMA_URL": "http://127.0.0.1:11434", "TMP": "./.local/socraticode/tmp", "TEMP": "./.local/socraticode/tmp", "SOCRATICODE_GLOBAL_CONFIG_DIR": "./.local/socraticode/context"},
     "healthProbe": "codebase_health"},
    {"name": "atlassian", "type": "local", "required": true, "clients": ["opencode", "codex", "vscode", "mcp"],
     "command": "node",
     "args": ["--env-file=.env", "tools/mcp-runtime/node_modules/mcp-remote/dist/proxy.js", "http://192.168.100.108:9871/mcp", "--transport", "http-only", "--silent", "--allow-http"],
     "env": ["MCP_REMOTE_CONFIG_DIR"], "envValues": {"MCP_REMOTE_CONFIG_DIR": ".local/mcp-auth/atlassian"},
     "vscode": {"type": "stdio", "cwd": "${workspaceFolder}"}, "healthProbe": "mcp tools/list"},
    {"name": "gitlab", "type": "local", "required": true, "clients": ["opencode", "codex", "vscode", "mcp"],
     "command": "node",
     "args": ["--env-file=.env", "tools/mcp-runtime/node_modules/mcp-remote/dist/proxy.js", "http://192.168.100.108:3002/mcp", "--transport", "http-only", "--silent", "--allow-http", "--header", "Authorization:${MCP_GITLAB_AUTHORIZATION}"],
     "env": ["MCP_REMOTE_CONFIG_DIR", "MCP_GITLAB_AUTHORIZATION"], "envValues": {"MCP_REMOTE_CONFIG_DIR": ".local/mcp-auth/gitlab"},
     "vscode": {"type": "stdio", "cwd": "${workspaceFolder}"}, "healthProbe": "mcp tools/list"},
{"name": "mattermost", "type": "local", "required": true, "clients": ["opencode", "codex", "vscode", "mcp"],
      "command": "node",
      "args": ["--env-file=.env", "tools/mcp-runtime/node_modules/mcp-remote/dist/proxy.js", "https://chat.rocketscien.se/plugins/mattermost-ai/mcp-server/mcp", "--transport", "http-only", "--silent", "--header", "Authorization:${MCP_MATTERMOST_AUTHORIZATION}"],
      "env": ["MCP_REMOTE_CONFIG_DIR", "MCP_MATTERMOST_AUTHORIZATION"], "envValues": {"MCP_REMOTE_CONFIG_DIR": ".local/mcp-auth/mattermost"},
      "vscode": {"type": "stdio", "cwd": "${workspaceFolder}"}, "healthProbe": "mcp tools/list"},
     {"name": "slider_gitlab", "type": "local", "required": true, "clients": ["opencode", "codex", "vscode", "mcp"],
      "command": "node",
      "args": ["--env-file=.env", "tools/mcp-runtime/node_modules/mcp-remote/dist/proxy.js", "https://mcp.slider-ai.ru/gitlab", "--transport", "http-only", "--silent", "--header", "Authorization:${MCP_SLIDER_GITLAB_AUTHORIZATION}"],
      "env": ["MCP_REMOTE_CONFIG_DIR", "MCP_SLIDER_GITLAB_AUTHORIZATION"], "envValues": {"MCP_REMOTE_CONFIG_DIR": ".local/mcp-auth/slider_gitlab"},
      "vscode": {"type": "stdio", "cwd": "${workspaceFolder}"}, "healthProbe": "mcp tools/list"},
    {"name": "test_ssh", "type": "local", "required": true, "clients": ["opencode", "codex", "vscode", "mcp"],
     "command": "node",
     "args": ["--env-file=.env", "tools/mcp-runtime/node_modules/mcp-remote/dist/proxy.js", "http://192.168.100.108:3111/mcp", "--transport", "http-only", "--silent", "--allow-http", "--header", "Authorization:${MCP_SSH_AUTHORIZATION}"],
     "env": ["MCP_REMOTE_CONFIG_DIR", "MCP_SSH_AUTHORIZATION"], "envValues": {"MCP_REMOTE_CONFIG_DIR": ".local/mcp-auth/test_ssh"},
     "vscode": {"type": "stdio", "cwd": "${workspaceFolder}"}, "healthProbe": "list_servers"},
    {"name": "test_pgdb", "type": "local", "required": true, "clients": ["opencode", "codex", "vscode", "mcp"],
     "command": "node",
     "args": ["--env-file=.env", "tools/mcp-runtime/node_modules/mcp-remote/dist/proxy.js", "http://192.168.100.108:2345/mcp", "--transport", "http-only", "--silent", "--allow-http"],
     "env": ["MCP_REMOTE_CONFIG_DIR"], "envValues": {"MCP_REMOTE_CONFIG_DIR": ".local/mcp-auth/test_pgdb"},
     "vscode": {"type": "stdio", "cwd": "${workspaceFolder}"}, "healthProbe": "list"},
    {"name": "test_graylog", "type": "local", "required": true, "clients": ["opencode", "codex", "vscode", "mcp"],
     "command": "node",
     "args": ["--env-file=.env", "tools/mcp-runtime/node_modules/mcp-remote/dist/proxy.js", "https://graylog.rocketscien.se/api/mcp", "--transport", "http-only", "--silent", "--header", "Authorization:${MCP_GRAYLOG_AUTHORIZATION}"],
     "env": ["MCP_REMOTE_CONFIG_DIR", "MCP_GRAYLOG_AUTHORIZATION"], "envValues": {"MCP_REMOTE_CONFIG_DIR": ".local/mcp-auth/test_graylog"},
     "vscode": {"type": "stdio", "cwd": "${workspaceFolder}"}, "healthProbe": "get_current_time"},
    {"name": "test_grafana", "type": "local", "required": true, "clients": ["opencode", "codex", "vscode", "mcp"],
     "command": "node",
     "args": ["--env-file=.env", "tools/mcp-runtime/node_modules/mcp-remote/dist/proxy.js", "http://192.168.100.108:8030/mcp", "--transport", "http-only", "--silent", "--allow-http"],
     "env": ["MCP_REMOTE_CONFIG_DIR"], "envValues": {"MCP_REMOTE_CONFIG_DIR": ".local/mcp-auth/test_grafana"},
     "vscode": {"type": "stdio", "cwd": "${workspaceFolder}"}, "healthProbe": "check_datasources_health"},
    {"name": "playwright", "type": "local", "required": true, "clients": ["opencode", "codex", "vscode", "mcp"],
     "command": "node",
     "args": ["--env-file=.env", "tools/mcp-runtime/node_modules/mcp-remote/dist/proxy.js", "http://192.168.100.108:8931/mcp", "--transport", "http-only", "--silent", "--allow-http"],
     "env": ["MCP_REMOTE_CONFIG_DIR"], "envValues": {"MCP_REMOTE_CONFIG_DIR": ".local/mcp-auth/playwright"},
     "vscode": {"type": "stdio", "cwd": "${workspaceFolder}"}, "healthProbe": "browser_snapshot"},
    {"name": "context7", "type": "local", "required": true, "clients": ["opencode", "codex", "vscode", "mcp"],
     "command": "node",
     "args": ["--env-file=.env", "tools/mcp-runtime/node_modules/mcp-remote/dist/proxy.js", "https://mcp.context7.com/mcp", "--transport", "http-only", "--silent"],
     "env": ["MCP_REMOTE_CONFIG_DIR"], "envValues": {"MCP_REMOTE_CONFIG_DIR": ".local/mcp-auth/context7"},
     "vscode": {"type": "stdio", "cwd": "${workspaceFolder}"}, "healthProbe": "resolve-library-id"},
    {"name": "zai", "type": "local", "required": true, "clients": ["opencode", "codex", "vscode", "mcp"],
     "command": "node",
     "args": ["--env-file=.env", "-e", "process.env.Z_AI_MODE='ZAI'; const p=require('node:child_process').spawn('npx',['-y','@z_ai/mcp-server@0.1.5'],{stdio:'inherit',shell:process.platform==='win32'}); p.on('exit',c=>process.exit(c??1));"],
     "env": ["Z_AI_MODE"], "envValues": {"Z_AI_MODE": "ZAI"},
     "healthProbe": "analyze_image"}
  ]
}
