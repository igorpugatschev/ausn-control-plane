{
  "$schema": "https://opencode.ai/config.json",
  // Запускать opencode из корня control plane: пути .env, tools/mcp-runtime и .local относительные.
  // Отключён 2026-10-02: кэш superpowers@git+… (переустановлен 10-01 20:34) не имеет main/index.js,
  // плагин резолвится в undefined и ронял обычный запуск opencode («plugin config hook failed» N.config).
  // "plugin": [
  //   "superpowers@git+https://github.com/obra/superpowers.git#b36e0829c6d0140e93cfef2ca599b1b07d4a7797"
  // ],
  "instructions": [
    "ENVIRONMENT.md"
  ],
  // Без этого блока opencode запрашивает подтверждение на каждый bash/скрипт и на
  // доступ к путям вне проекта (например, рабочие копии Slider в ../slider-web).
  // Значения — как в slider-web-control-plane/opencode.json.
  "permission": {
    "read": "allow",
    "edit": "allow",
    "bash": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "external_directory": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "todowrite": "allow",
    "question": "allow",
    "lsp": "allow",
    "skill": "allow"
  },
  "mcp": {
    "socraticode": {
      "type": "local",
      "command": [
        "node",
        "-e",
        "process.env.TMP=process.env.TEMP=require('node:path').resolve('.local/socraticode/tmp'); const {spawn}=require('node:child_process'); const env={...process.env,NODE_OPTIONS:((process.env.NODE_OPTIONS||'')+' --max-old-space-size=4096').trim()}; const boot=()=>spawn('npx',['-y','socraticode@1.14.0'],{stdio:'inherit',shell:process.platform==='win32',env}).on('exit',()=>setTimeout(boot,1500)); boot();"
      ],
      "enabled": true,
      "environment": {
        "QDRANT_MODE": "external",
        "QDRANT_URL": "http://127.0.0.1:17333",
        "QDRANT_COLLECTION_PREFIX": "ausn_qa_",
        "EMBEDDING_PROVIDER": "ollama",
        "EMBEDDING_MODEL": "nomic-embed-text",
        "OLLAMA_MODE": "external",
        "OLLAMA_URL": "http://127.0.0.1:11434",
        "TMP": "./.local/socraticode/tmp",
        "TEMP": "./.local/socraticode/tmp",
        "SOCRATICODE_GLOBAL_CONFIG_DIR": "./.local/socraticode/context"
      }
    },
    "atlassian": {
      "type": "local",
      "command": [
        "node",
        "--env-file=.env",
        "tools/mcp-runtime/node_modules/mcp-remote/dist/proxy.js",
        "http://192.168.100.108:9871/mcp",
        "--transport",
        "http-only",
        "--silent",
        "--allow-http"
      ],
      "enabled": true,
      "environment": {
        "MCP_REMOTE_CONFIG_DIR": ".local/mcp-auth/atlassian"
      }
    },
    "gitlab": {
      "type": "local",
      "command": [
        "node",
        "--env-file=.env",
        "tools/mcp-runtime/node_modules/mcp-remote/dist/proxy.js",
        "http://192.168.100.108:3002/mcp",
        "--transport",
        "http-only",
        "--silent",
        "--allow-http",
        "--header",
        "Authorization:${MCP_GITLAB_AUTHORIZATION}"
      ],
      "enabled": true,
      "environment": {
        "MCP_REMOTE_CONFIG_DIR": ".local/mcp-auth/gitlab"
      }
    },
    "mattermost": {
      "type": "local",
      "command": [
        "node",
        "--env-file=.env",
        "tools/mcp-runtime/node_modules/mcp-remote/dist/proxy.js",
        "https://chat.rocketscien.se/plugins/mattermost-ai/mcp-server/mcp",
        "--transport",
        "http-only",
        "--silent",
        "--header",
        "Authorization:${MCP_MATTERMOST_AUTHORIZATION}"
      ],
      "enabled": true,
      "environment": {
        "MCP_REMOTE_CONFIG_DIR": ".local/mcp-auth/mattermost"
      }
    },
    "slider_gitlab": {
      "type": "local",
      "command": [
        "node",
        "--env-file=.env",
        "tools/mcp-runtime/node_modules/mcp-remote/dist/proxy.js",
        "https://mcp.slider-ai.ru/gitlab",
        "--transport",
        "http-only",
        "--silent",
        "--header",
        "Authorization:${MCP_SLIDER_GITLAB_AUTHORIZATION}"
      ],
      "enabled": true,
      "environment": {
        "MCP_REMOTE_CONFIG_DIR": ".local/mcp-auth/slider_gitlab"
      }
    },
    "test_ssh": {
      "type": "local",
      "command": [
        "node",
        "--env-file=.env",
        "tools/mcp-runtime/node_modules/mcp-remote/dist/proxy.js",
        "http://192.168.100.108:3111/mcp",
        "--transport",
        "http-only",
        "--silent",
        "--allow-http",
        "--header",
        "Authorization:${MCP_SSH_AUTHORIZATION}"
      ],
      "enabled": true,
      "environment": {
        "MCP_REMOTE_CONFIG_DIR": ".local/mcp-auth/test_ssh"
      }
    },
    "test_pgdb": {
      "type": "local",
      "command": [
        "node",
        "--env-file=.env",
        "tools/mcp-runtime/node_modules/mcp-remote/dist/proxy.js",
        "http://192.168.100.108:2345/mcp",
        "--transport",
        "http-only",
        "--silent",
        "--allow-http"
      ],
      "enabled": true,
      "environment": {
        "MCP_REMOTE_CONFIG_DIR": ".local/mcp-auth/test_pgdb"
      }
    },
    "test_graylog": {
      "type": "local",
      "command": [
        "node",
        "--env-file=.env",
        "tools/mcp-runtime/node_modules/mcp-remote/dist/proxy.js",
        "https://graylog.rocketscien.se/api/mcp",
        "--transport",
        "http-only",
        "--silent",
        "--header",
        "Authorization:${MCP_GRAYLOG_AUTHORIZATION}"
      ],
      "enabled": true,
      "environment": {
        "MCP_REMOTE_CONFIG_DIR": ".local/mcp-auth/test_graylog"
      }
    },
    "test_grafana": {
      "type": "local",
      "command": [
        "node",
        "--env-file=.env",
        "tools/mcp-runtime/node_modules/mcp-remote/dist/proxy.js",
        "http://192.168.100.108:8030/mcp",
        "--transport",
        "http-only",
        "--silent",
        "--allow-http"
      ],
      "enabled": true,
      "environment": {
        "MCP_REMOTE_CONFIG_DIR": ".local/mcp-auth/test_grafana"
      }
    },
    "playwright": {
      "type": "local",
      "command": [
        "node",
        "--env-file=.env",
        "tools/mcp-runtime/node_modules/mcp-remote/dist/proxy.js",
        "http://192.168.100.108:8931/mcp",
        "--transport",
        "http-only",
        "--silent",
        "--allow-http"
      ],
      "enabled": true,
      "environment": {
        "MCP_REMOTE_CONFIG_DIR": ".local/mcp-auth/playwright"
      }
    },
    "dozzle": {
      // real-time логи/статы контейнеров стенда Slider (read-only MCP).
      // Поднимается отдельным compose: profiles/slider/docker/compose.observability.yml
      "type": "local",
      "command": [
        "node",
        "--env-file=.env",
        "tools/mcp-runtime/node_modules/mcp-remote/dist/proxy.js",
        "http://127.0.0.1:8081/api/mcp",
        "--transport",
        "http-only",
        "--silent",
        "--allow-http"
      ],
      "enabled": true,
      "environment": {
        "MCP_REMOTE_CONFIG_DIR": ".local/mcp-auth/dozzle"
      }
    },
    "context7": {
      "type": "local",
      "command": [
        "node",
        "--env-file=.env",
        "tools/mcp-runtime/node_modules/mcp-remote/dist/proxy.js",
        "https://mcp.context7.com/mcp",
        "--transport",
        "http-only",
        "--silent"
      ],
      "enabled": true,
      "environment": {
        "MCP_REMOTE_CONFIG_DIR": ".local/mcp-auth/context7"
      }
    },
    "zai": {
      "type": "local",
      "command": [
        "node",
        "--env-file=.env",
        "-e",
        "process.env.Z_AI_MODE='ZAI'; const p=require('node:child_process').spawn('npx',['-y','@z_ai/mcp-server@0.1.5'],{stdio:'inherit',shell:process.platform==='win32'}); p.on('exit',c=>process.exit(c??1));"
      ],
      "enabled": true,
      "environment": {
        "Z_AI_MODE": "ZAI"
      }
    }
  },
  "provider": {
    "routerai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "RouterAI · корпоративный",
      "options": {
        "baseURL": "https://routerai.ru/api/v1"
      },
      "models": {
        "anthropic/claude-opus-5.5": {
          "name": "Anthropic: Claude Opus 5.5",
          "reasoning": true,
          "toolcall": true,
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "openai/gpt-6-astra-pro": {
          "name": "OpenAI: GPT-6 Astra Pro",
          "reasoning": true,
          "toolcall": true,
          "limit": {
            "context": 1050000,
            "output": 65536
          },
          "modalities": {
            "input": [
              "image",
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "openai/gpt-6-astra": {
          "name": "OpenAI: GPT-6 Astra",
          "reasoning": true,
          "toolcall": true,
          "limit": {
            "context": 1050000,
            "output": 65536
          },
          "modalities": {
            "input": [
              "image",
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "openai/gpt-6.1-sol": {
          "name": "OpenAI: GPT-6.1 Sol",
          "reasoning": true,
          "toolcall": true,
          "limit": {
            "context": 1050000,
            "output": 65536
          },
          "modalities": {
            "input": [
              "image",
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "anthropic/claude-sonnet-5.5": {
          "name": "Anthropic: Claude Sonnet 5.5",
          "reasoning": true,
          "toolcall": true,
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "google/gemini-3.1-pro-preview": {
          "name": "Google: Gemini 3.1 Pro Preview",
          "reasoning": true,
          "toolcall": true,
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": [
              "audio",
              "image",
              "text",
              "video"
            ],
            "output": [
              "text"
            ]
          }
        },
        "deepseek/deepseek-v4-pro-0813": {
          "name": "DeepSeek: DeepSeek V4 Pro 0813",
          "reasoning": true,
          "toolcall": true,
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "x-ai/grok-4.7": {
          "name": "SpaceXAI: Grok 4.7",
          "reasoning": true,
          "toolcall": true,
          "limit": {
            "context": 500000,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "autoupdate": true
}
